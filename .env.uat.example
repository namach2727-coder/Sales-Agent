APP_ENV=uat
APP_VERSION=0.10.0
BUILD_SHA=replace-with-build-sha
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
DATABASE_URL=postgresql+psycopg://replace-user:replace-password@replace-host:5432/replace-database
APPLICATION_SECRET=replace-with-at-least-32-random-characters
TRUSTED_HOSTS=uat.example.com
CORS_ALLOWED_ORIGINS=https://uat.example.com
FORCE_HTTPS=true
FORWARDED_ALLOW_IPS=replace-with-trusted-proxy-cidrs
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
LEGACY_ADMIN_ADAPTER_ENABLED=false
