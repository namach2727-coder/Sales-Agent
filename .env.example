# Canonical DirectPilot configuration template.
# Optional startup profiles: copy an example to .env.dev/.env.uat/.env.production,
# then set DIRECTPILOT_ENV_PROFILE=dev, uat, or production before startup.
APP_NAME=Sales Assistant MVP
APP_ENV=development
APP_VERSION=0.10.0
BUILD_SHA=development
DEBUG=false
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=2
# Docker Compose runtime values. Use a URL-safe database password because the
# UAT Compose file constructs DATABASE_URL from these fields.
APP_PORT=8000
POSTGRES_DB=directpilot
POSTGRES_USER=directpilot
POSTGRES_PASSWORD=replace-with-a-url-safe-database-password
DATABASE_URL=sqlite:///./sales_assistant.db
# Deployment environments support mounted secrets with DATABASE_URL_FILE.
DATABASE_URL_FILE=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT=10
LOG_LEVEL=INFO
LOG_FORMAT=auto
APPLICATION_SECRET=
APPLICATION_SECRET_FILE=
TRUSTED_HOSTS=localhost,127.0.0.1,testserver,*
CORS_ALLOWED_ORIGINS=
FORWARDED_ALLOW_IPS=127.0.0.1
FORCE_HTTPS=false
SECURITY_HEADERS_ENABLED=true
# Deprecated: startup never runs seeds. Use python -m tools.seed_data explicitly.
SEED_DEMO_DATA=false
# Enter Meta credentials only through the local page: http://127.0.0.1:8000/instagram/setup
META_VERIFY_TOKEN=replace-me
META_APP_ID=replace-me
META_ACCESS_TOKEN=replace-me
META_ACCESS_TOKEN_FILE=
META_APP_SECRET=replace-me
META_APP_SECRET_FILE=
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
INSTAGRAM_TOKEN_ENCRYPTION_KEY=
INSTAGRAM_TOKEN_ENCRYPTION_KEY_FILE=
META_IG_USER_ID=replace-me
META_API_VERSION=v24.0
META_GRAPH_BASE_URL=https://graph.instagram.com
META_OAUTH_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
META_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
META_OAUTH_REDIRECT_URI=http://localhost:8000/api/v1/integrations/instagram/callback
META_OAUTH_STATE_TTL_MINUTES=10
META_OAUTH_TIMEOUT_SECONDS=20
INSTAGRAM_OUTBOUND_TIMEOUT_SECONDS=15
META_SEND_ENABLED=false
META_SEND_ALLOWED_ACCOUNT_IDS=
META_SIGNATURE_REQUIRED=true
# Posting is separate from replies and remains off until Meta grants
# instagram_business_content_publish and a permanent HTTPS media host is set.
META_CONTENT_PUBLISH_ENABLED=false
PUBLIC_MEDIA_BASE_URL=
MEDIA_SIGNING_SECRET=replace-me-with-a-long-random-secret
MEDIA_SIGNING_SECRET_FILE=
MEDIA_STORAGE_ROOT=./private_media
# Production example: shops.example.com -> store1.shops.example.com
TENANT_BASE_DOMAIN=
TENANT_URL_SCHEME=https
TELEGRAM_BOT_TOKEN=replace-me
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_WEBHOOK_SECRET=replace-me
TELEGRAM_WEBHOOK_SECRET_FILE=
TELEGRAM_SEND_ENABLED=false
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_POLL_TIMEOUT=25
MANYCHAT_DYNAMIC_BLOCK_SECRET=replace-me-with-a-long-random-secret
MANYCHAT_DYNAMIC_BLOCK_SECRET_FILE=
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_API_KEY_FILE=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_OUTPUT_TOKENS=128
OLLAMA_THINKING_ENABLED=false
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=
GROQ_TIMEOUT_SECONDS=60
GROQ_MAX_OUTPUT_TOKENS=256
GROQ_CONTEXT_LENGTH=4096
GROQ_REASONING_EFFORT=none
# Persistent identity and opaque-session policy. Keep Secure cookies enabled
# behind production HTTPS; local plain HTTP development may explicitly set false.
AUTHENTICATION_ENABLED=true
LEGACY_ADMIN_ADAPTER_ENABLED=true
SESSION_TTL_MINUTES=480
SESSION_COOKIE_NAME=sales_agent_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=1024
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
# Manual card-transfer provider. Configure only through deployment secrets.
CARD_TRANSFER_CARD_NUMBER=
CARD_TRANSFER_ACCOUNT_NUMBER=
CARD_TRANSFER_ACCOUNT_NAME=
CARD_TRANSFER_BANK_NAME=
CARD_TRANSFER_INSTRUCTIONS=
RECEIPT_STORAGE_ROOT=./private_receipts
RECEIPT_MAX_BYTES=5242880
