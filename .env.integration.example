APP_ENV=integration
APP_VERSION=0.10.0
BUILD_SHA=local
DEBUG=false
LOG_LEVEL=INFO
LOG_FORMAT=json
APPLICATION_SECRET=replace-with-at-least-32-random-characters
TRUSTED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000
FORCE_HTTPS=false
FORWARDED_ALLOW_IPS=127.0.0.1
SESSION_COOKIE_SECURE=false
LEGACY_ADMIN_ADAPTER_ENABLED=false
POSTGRES_DB=sales_agent_integration
POSTGRES_USER=sales_agent
POSTGRES_PASSWORD=replace-with-a-random-local-integration-password
DATABASE_URL=postgresql+psycopg://sales_agent:replace-with-url-encoded-password@database:5432/sales_agent_integration
APP_PORT=8000
