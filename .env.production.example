# DirectPilot production profile.
# Copy to the gitignored .env.production file and replace every placeholder.
APP_NAME=DirectPilot
APP_ENV=production
APP_VERSION=0.10.0
BUILD_SHA=replace-with-build-sha
DEBUG=false
HOST=0.0.0.0
PORT=8000
WEB_CONCURRENCY=2
APP_PORT=8000
POSTGRES_DB=directpilot
POSTGRES_USER=directpilot
POSTGRES_PASSWORD=replace-with-a-url-safe-database-password
DATABASE_URL=postgresql+psycopg://directpilot:replace-with-a-url-safe-database-password@postgresql:5432/directpilot
DATABASE_URL_FILE=
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=1800
DATABASE_CONNECT_TIMEOUT=10
LOG_LEVEL=INFO
LOG_FORMAT=json
APPLICATION_SECRET=replace-with-at-least-32-random-characters
APPLICATION_SECRET_FILE=
TRUSTED_HOSTS=api.directpilot.ir
CORS_ALLOWED_ORIGINS=https://directpilot.ir
FORWARDED_ALLOW_IPS=127.0.0.1
FORCE_HTTPS=true
SECURITY_HEADERS_ENABLED=true
SEED_DEMO_DATA=false
META_VERIFY_TOKEN=replace-me
META_APP_ID=replace-me
META_ACCESS_TOKEN=
META_ACCESS_TOKEN_FILE=
META_APP_SECRET=replace-with-meta-app-secret
META_APP_SECRET_FILE=
INSTAGRAM_TOKEN_ENCRYPTION_KEY=replace-with-a-generated-fernet-key
INSTAGRAM_TOKEN_ENCRYPTION_KEY_FILE=
META_IG_USER_ID=
META_API_VERSION=v24.0
META_GRAPH_BASE_URL=https://graph.instagram.com
META_OAUTH_AUTHORIZE_URL=https://www.instagram.com/oauth/authorize
META_OAUTH_TOKEN_URL=https://api.instagram.com/oauth/access_token
META_OAUTH_REDIRECT_URI=https://api.directpilot.ir/api/v1/integrations/instagram/callback
META_OAUTH_STATE_TTL_MINUTES=10
META_OAUTH_TIMEOUT_SECONDS=20
INSTAGRAM_OUTBOUND_TIMEOUT_SECONDS=15
META_SEND_ENABLED=false
META_SEND_ALLOWED_ACCOUNT_IDS=
META_SIGNATURE_REQUIRED=true
META_CONTENT_PUBLISH_ENABLED=false
PUBLIC_MEDIA_BASE_URL=https://api.directpilot.ir
MEDIA_SIGNING_SECRET=replace-with-a-long-random-secret
MEDIA_SIGNING_SECRET_FILE=
MEDIA_STORAGE_ROOT=/app/private_media
TENANT_BASE_DOMAIN=directpilot.ir
TENANT_URL_SCHEME=https
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_TOKEN_FILE=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_SECRET_FILE=
TELEGRAM_SEND_ENABLED=false
TELEGRAM_POLLING_ENABLED=false
TELEGRAM_POLL_TIMEOUT=25
MANYCHAT_DYNAMIC_BLOCK_SECRET=
MANYCHAT_DYNAMIC_BLOCK_SECRET_FILE=
LLM_PROVIDER=openai
OPENAI_API_KEY=replace-with-provider-api-key
OPENAI_API_KEY_FILE=
OPENAI_MODEL=gpt-5.6-sol
OPENAI_TIMEOUT_SECONDS=30
OPENAI_MAX_RETRIES=1
OLLAMA_API_KEY=
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_CONTEXT_LENGTH=4096
OLLAMA_MAX_OUTPUT_TOKENS=128
OLLAMA_THINKING_ENABLED=false
AUTHENTICATION_ENABLED=true
LEGACY_ADMIN_ADAPTER_ENABLED=false
SESSION_TTL_MINUTES=480
SESSION_COOKIE_NAME=sales_agent_session
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
PASSWORD_MIN_LENGTH=12
PASSWORD_MAX_LENGTH=1024
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
CARD_TRANSFER_CARD_NUMBER=replace-with-card-number
CARD_TRANSFER_ACCOUNT_NUMBER=replace-with-account-number
CARD_TRANSFER_ACCOUNT_NAME=replace-with-account-holder-name
CARD_TRANSFER_BANK_NAME=replace-with-bank-name
CARD_TRANSFER_INSTRUCTIONS=replace-with-customer-facing-transfer-instructions
RECEIPT_STORAGE_ROOT=/app/private_receipts
RECEIPT_MAX_BYTES=5242880
